# Chama.ai - Environment Variables
# Copy to .env.local and fill in your values

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/chama?sslmode=require"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# OpenAI (for LangChain agent)
OPENAI_API_KEY="sk-..."

# PayPal (Sandbox for testing)
# SECURITY: never commit real credentials — set them only in .env.local
# Get sandbox credentials at: https://developer.paypal.com/dashboard/applications
# Enable the "Payouts" feature on your REST app for distribute/escrow tools.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYPAL_CLIENT_SECRET="Exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYPAL_WEBHOOK_ID="WH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Upstash Redis (for background jobs)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Upstash QStash (for scheduled jobs)
QSTASH_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
QSTASH_URL="https://qstash.upstash.io"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Chama.ai"

# Postgres — your database connection
DATABASE_URL="postgresql://neondb_owner:npg_cwL3QeMR9kSD@ep-green-union-a7zvs7hi.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:npg_cwL3QeMR9kSD@ep-green-union-a7zvs7hi-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Managed Better Auth — sign-in for your app
NEON_AUTH_BASE_URL="https://ep-green-union-a7zvs7hi.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth"

# MCP Server — API keys for external AI agents (JSON: key -> userId)
MCP_API_KEYS={\"mcp_key_change_me\":\"user-id-or-email\"}
# MCP Server — merchant id used in the ACP discovery manifest
MCP_MERCHANT_ID="chama-ai-alpha"